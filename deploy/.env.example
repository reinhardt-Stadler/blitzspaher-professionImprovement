# ─────────────────────────────────────────────────────────────
# blitzspaher 实验环境变量
#
# 用法：
#   cp .env.example .env
#   # 填入真实密钥
#   docker compose up -d
#
# 注意：.env 已在 .gitignore 中排除，不会进库。
# ─────────────────────────────────────────────────────────────

# ── 模型凭据（必填）──────────────────────────────────────────
# 主力模型（ADR-002）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 备选模型（可选，若不使用可留空）
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 授权范围（SEC-AUTHZ-01）──────────────────────────────────
# 逗号分隔；容器内靶场主机名固定为 target
PENTEST_ALLOWED_TARGETS=target,127.0.0.1,localhost

# ── 执行预算（SEC-BUDGET-01，数值待 OQ-09 冻结）──────────────
PENTEST_MAX_CALLS=12
PENTEST_MAX_RUNTIME_MS=600000

# ── 观测（A 方案）───────────────────────────────────────────
# on  = 启用裁决（正常跑）
# off = 仅记录不拦截（对照实验基线）
PENTEST_ARM=on

# 运行 ID（留空则自动生成）
PENTEST_RUN_ID=
